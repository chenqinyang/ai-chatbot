DEEPSEEK_API_KEY=paste-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
COPILOT_MODEL=deepseek-v4-flash
PORT=4000
HOST=127.0.0.1

# Module Federation endpoints read by the Host UI build.
PROFILE_UI_REMOTE_URL=http://127.0.0.1:3001/mf-manifest.json
PRODUCT_UI_REMOTE_URL=http://127.0.0.1:3002/mf-manifest.json
CHATBOT_UI_REMOTE_URL=http://127.0.0.1:3003/mf-manifest.json

# Leave relative for local development; set an absolute URL when the runtime is deployed separately.
PUBLIC_COPILOT_RUNTIME_URL=/api/copilotkit
