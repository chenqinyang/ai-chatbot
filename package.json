{
  "name": "copilotkit-federated-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/profile-ui"
  ],
  "scripts": {
    "dev": "concurrently -k -n runtime,profile-adapter,profile-legacy,product,chat,host -c yellow,blue,cyan,cyan,magenta,green \"npm:dev:server\" \"npm:dev:profile:adapter\" \"npm:dev:profile:legacy\" \"npm:dev:product\" \"npm:dev:chat\" \"npm:dev:host\"",
    "dev:host": "rsbuild dev --config apps/host/rsbuild.config.js",
    "dev:profile": "concurrently -k -n adapter,legacy -c blue,cyan \"npm:dev:profile:adapter\" \"npm:dev:profile:legacy\"",
    "dev:profile:adapter": "rsbuild dev --config apps/profile-ui/rsbuild.config.js",
    "dev:profile:legacy": "rsbuild dev --config apps/profile-ui/rsbuild.legacy.config.js",
    "dev:product": "rsbuild dev --config apps/product-ui/rsbuild.config.js",
    "dev:chat": "rsbuild dev --config apps/chatbot-ui/rsbuild.config.js",
    "dev:server": "node apps/host/server/index.js",
    "build": "npm run build:profile && npm run build:product && npm run build:chat && npm run build:host",
    "build:host": "rsbuild build --config apps/host/rsbuild.config.js",
    "build:profile": "npm run build:profile:legacy && npm run build:profile:adapter",
    "build:profile:adapter": "rsbuild build --config apps/profile-ui/rsbuild.config.js",
    "build:profile:legacy": "rsbuild build --config apps/profile-ui/rsbuild.legacy.config.js",
    "build:product": "rsbuild build --config apps/product-ui/rsbuild.config.js",
    "build:chat": "rsbuild build --config apps/chatbot-ui/rsbuild.config.js",
    "preview:host": "rsbuild preview --config apps/host/rsbuild.config.js",
    "preview:profile": "concurrently -k -n adapter,legacy -c blue,cyan \"npm:preview:profile:adapter\" \"npm:preview:profile:legacy\"",
    "preview:profile:adapter": "rsbuild preview --config apps/profile-ui/rsbuild.config.js",
    "preview:profile:legacy": "rsbuild preview --config apps/profile-ui/rsbuild.legacy.config.js",
    "preview:product": "rsbuild preview --config apps/product-ui/rsbuild.config.js",
    "preview:chat": "rsbuild preview --config apps/chatbot-ui/rsbuild.config.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.76",
    "@copilotkit/react-core": "^1.61.2",
    "@copilotkit/react-ui": "^1.61.2",
    "@copilotkit/runtime": "^1.61.2",
    "@module-federation/bridge-react": "2.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.561.0",
    "openai": "^6.10.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.8.0",
    "@rsbuild/core": "^2.1.6",
    "@rsbuild/plugin-react": "^2.1.0"
  }
}
